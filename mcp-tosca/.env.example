# Ruta al ejecutable de TestExecutionCli.exe (viene con la instalación de Tosca Commander)
TOSCA_CLI_PATH=C:\Program Files (x86)\TRICENTIS\Tosca Testsuite\TestExecutionCli\TestExecutionCli.exe

# Tipo y servidor de la base de datos del repositorio Tosca
TOSCA_DB_TYPE=MSSQL_TOSCACI
TOSCA_DB_SERVER=mi-servidor-sql\INSTANCIA

# Servidor de Tosca (workspace/repositorio)
TOSCA_SERVER=mi-servidor-tosca

# Usuario de Tosca
TOSCA_LOGIN=mi.usuario

# Nombre de la variable de entorno que contiene la contraseña real (no el valor).
# TestExecutionCli lee la contraseña de esa variable para no exponerla en la línea de comandos.
TOSCA_PASSWORD_ENV=TOSCA_PASSWORD

# Define aparte la variable referenciada arriba con la contraseña real:
# TOSCA_PASSWORD=********

# Nombre del proyecto Tosca
TOSCA_PROJECT=MiProyecto

# Opcional: TCP/workspace si el repositorio lo requiere
# TOSCA_TCP=MiWorkspace
